{
  "name": "comparebuilds",
  "version": "1.0.0",
  "description": "World of Warcraft talent-build comparison tool (comparebuilds.app).",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerenderSpecs.js && node scripts/generateLayoutManifest.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:svg": "svgo public/favicon.svg",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "check:csp": "node tools/check-csp.mjs",
    "check:og": "node tools/check-og-image.mjs",
    "check:wire-layout": "node scripts/checkWireLayout.js",
    "check:game-build": "node scripts/checkGameBuild.js",
    "data:top-builds": "node scripts/fetchTopBuilds.js --write",
    "links": "lychee --config lychee.toml --root-dir public README.md CLAUDE.md SECURITY.md index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Markus Spitzner",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.8.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "markdown-it": "^14.2.0",
    "js-yaml": "^4.3.2",
    "smol-toml": "~1.7.2"
  }
}
