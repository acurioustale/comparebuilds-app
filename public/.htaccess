# comparebuilds.app — Apache config for the static site root.
# Lives in public/ so Vite copies it into dist/ and the rsync deploy ships it
# to the web root. The SPA itself uses hash routing; the rewrite below adds
# server-rendered share pages so links unfurl with a per-build preview.

# ─── Pretty share URLs ─────────────────────────────────────────────────────────
# /s/<id> → the PHP share page (Open Graph meta + image; redirects humans to the
# SPA at /#<id>). Requires mod_rewrite; harmless if the module is absent.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Redirect to the canonical host literally rather than echoing
  # %{HTTP_HOST}: a client-supplied (and, behind a proxy, forwardable) Host header
  # would otherwise make this a 301 to an attacker-chosen origin (open redirect /
  # cached-redirect poisoning). comparebuilds.app is the single canonical origin.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://comparebuilds.app%{REQUEST_URI} [L,R=301]

  # Share URLs. No QSA: this rule supplies the only params share.php reads
  # (page, id from the validated path segment). Appending the client query string
  # would let a request like /s/<id>?id=<other> inject a second id= that, by PHP's
  # last-wins parsing, overrides $_GET['id']. valid_share_id() still gates it, but
  # dropping QSA removes the client's ability to steer the internal request at all.
  RewriteRule ^s/([A-Za-z0-9]{8,16})$ api/share.php?page=1&id=$1 [L]
</IfModule>


# ─── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Content-Security-Policy: everything the app needs is same-origin — bundled
  # JS/CSS/fonts, talent icons under /talent-icons (self-hosted; see scripts/fetchIcons.js)
  # and the share API (fetch). So img-src and connect-src are 'self' only, with no
  # third-party origins. Inline styles are allowed because React sets element
  # style attributes.
  #
  # The single inline <script> the build emits is the anti-flash theme resolver in
  # index.html; it is allowlisted by its sha256 hash rather than 'unsafe-inline'.
  # IMPORTANT: that hash is over the script's exact bytes — if you edit the inline
  # script in index.html, recompute it and update the value below, or the script
  # is silently blocked (reintroducing the theme flash). tools/check-csp.mjs (the
  # "CSP guard" gate step) recomputes the hash from the built dist/ and fails the
  # build if this token has drifted, so the two can't fall out of sync unnoticed.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-xh7M2t3oCHA26cHM02ChDRcJob4ZPTl0JQfjj9EbBJo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Force HTTPS for all connections (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cross-origin isolation. Everything the app loads is same-origin (bundled
  # JS/CSS/fonts, /talent-icons, the share API), so isolate the browsing context
  # from cross-origin windows (COOP) and forbid other origins from embedding our
  # responses (CORP). Deliberately NOT Cross-Origin-Embedder-Policy: require-corp
  # — the app needs no cross-origin isolation (no SharedArrayBuffer), and COEP
  # would add breakage risk for any future cross-origin resource with no upside.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # No `Header unset Server` here: mod_headers runs before Apache's core writes
  # the Server banner, so it can't remove it (verified 2026-09-17 — the live
  # response still carried `Server: Apache` while that directive was in place).
  # Trimming the banner needs ServerTokens/ServerSignature, which are
  # server-config context and not permitted in .htaccess on this shared host.
  # The host already sets `ServerTokens Prod`, so only the bare `Apache` token
  # (no version) is exposed; nothing further is actionable at this layer.

  # Long-cache static images. The self-hosted icons under /talent-icons are keyed
  # by a stable game slug (fetchIcons.js only ever adds files, never mutates one),
  # so they're safe to cache aggressively — this replaces the icon-cache service
  # worker that used to do this client-side. (The path is /talent-icons rather
  # than /icons because Apache reserves /icons for its autoindex graphics.)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Vite bundles have content hashes, so they can be cached long-term
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ─── MIME types ────────────────────────────────────────────────────────────────
# Some hosts don't map .webmanifest by default; browsers reject the manifest
# unless it is served as application/manifest+json.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ─── Deny sensitive files (defense in depth) ───────────────────────────────────
# config.php normally lives ONE LEVEL ABOVE the web root and is already
# unreachable; this guards against a stray copy or template ever landing here,
# and blocks dotfiles (e.g. this .htaccess, any .env) from being served.
<FilesMatch "(^\.|\.example$|^config\.php$)">
  Require all denied
</FilesMatch>

# ─── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/json application/javascript text/javascript application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript application/manifest+json image/svg+xml
</IfModule>
